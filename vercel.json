{
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/ig-webhook",
            "destination": "/api/ig-webhook"
        },
        {
            "source": "/api/ai-edit",
            "destination": "/api/ai-edit"
        },
        {
            "source": "/api/ai-edit-status",
            "destination": "/api/ai-edit-status"
        },
        {
            "source": "/api/ai-edit-render",
            "destination": "/api/ai-edit-render"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
