{
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/ig-webhook",
            "destination": "/api/ig-webhook"
        },
        {
            "source": "/api/ai-edit",
            "destination": "/api/ai-edit"
        },
        {
            "source": "/api/ai-edit-status",
            "destination": "/api/ai-edit-status"
        },
        {
            "source": "/api/ai-edit-render",
            "destination": "/api/ai-edit-render"
        },
        {
            "source": "/api/ai-montage-render",
            "destination": "/api/ai-montage-render"
        },
        {
            "source": "/api/ai-montage-direct",
            "destination": "/api/ai-montage-direct"
        },
        {
            "source": "/api/ai-montage-transcribe",
            "destination": "/api/ai-montage-transcribe"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/ai-montage-render.js": {
            "maxDuration": 300,
            "memory": 1024,
            "includeFiles": "api/fonts/**"
        },
        "api/ai-montage-direct.js": {
            "maxDuration": 300,
            "memory": 3008,
            "includeFiles": "api/fonts/**"
        },
        "api/ai-montage-transcribe.js": {
            "maxDuration": 120,
            "memory": 1024
        }
    }
}
